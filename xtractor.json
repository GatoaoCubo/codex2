{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petcodex.com/schemas/cadastroUniversal.json",
  "title": "CadastroUniversal",
  "description": "Esquema de dados para cadastro empresarial universal, visando Big Data e aprendizado de agentes inteligentes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cnpj": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "description": "CNPJ sem pontuação"
    },
    "nome_negocio": {
      "type": "string",
      "minLength": 2
    },
    "categoria": {
      "type": "string",
      "description": "Segmento principal do negócio"
    },
    "segmento": {
      "type": "string",
      "description": "Descrição mais específica do segmento"
    },
    "interesses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importacao": { "type": "boolean" },
        "fabricacao": { "type": "boolean" },
        "tecnologia": { "type": "boolean" },
        "outros": { "type": "boolean" }
      }
    },
    "localizacao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidade": { "type": "string" },
        "estado": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "endereco": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rua": { "type": "string" },
        "numero": { "type": "string" },
        "bairro": { "type": "string" }
      }
    },
    "contato": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telefone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": {
          "type": "string",
          "format": "email"
        },
        "horario_atendimento": { "type": "string" }
      },
      "required": ["telefone", "email"]
    },
    "sobre_nos": {
      "type": "string",
      "minLength": 50
    },
    "servicos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "depoimentos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cliente": { "type": "string" },
          "texto": { "type": "string" }
        },
        "required": ["cliente", "texto"]
      }
    },
    "pedidos_erp": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codigo_pedido": { "type": "string" },
          "data": { "type": "string", "format": "date" },
          "valor_total": { "type": "number", "minimum": 0 },
          "origem": {
            "type": "string",
            "enum": ["bling", "mercadolivre", "outro"]
          }
        },
        "required": ["codigo_pedido", "data", "valor_total", "origem"]
      }
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": ["cnpj", "nome_negocio", "categoria", "contato", "servicos"]
}
